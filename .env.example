# ─────────────── API (NestJS) ───────────────
PORT=4000
NODE_ENV=development
# MongoDB must be a replica set to support transactions (Atlas is by default;
# for local dev run a single-node replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/rgiservice?replicaSet=rs0
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Production (see DEPLOY.md §6.4):
# https://rgiservice.ma,https://www.rgiservice.ma,https://rgi-service.vercel.app,https://*.vercel.app,http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─────────────── Cloudinary ───────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
CLOUDINARY_UPLOAD_PRESET=rgi_service_products
# Namespace for this project's media inside a Cloudinary account shared with other projects.
CLOUDINARY_FOLDER=rgi-service/products

# ─────────────── CMI payment (Morocco) ───────────────
CMI_MERCHANT_ID=your_merchant_id
CMI_STORE_KEY=your_store_key
CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate
# Server-to-server: must reach the NestJS API, not the storefront.
CMI_CALLBACK_URL=https://api.rgiservice.ma/api/v1/payments/cmi/callback
CMI_OK_URL=https://rgiservice.ma/commande/succes
CMI_FAIL_URL=https://rgiservice.ma/commande/echec

# ─────────────── WhatsApp — alerte « nouvelle commande » ───────────────
# The shop handset that receives an alert each time an order is placed. Digits only, no
# `+`. Defaults to the number the storefront's WhatsApp links already point at.
SHOP_WHATSAPP_NUMBER=212661827969
# CallMeBot relay key, obtained once per handset and free:
#   1. add +34 621 331 709 to the handset's contacts as "CallMeBot"
#   2. send it « I allow callmebot to send me messages »
#   3. it replies with the API key — paste it here
# Leave EMPTY to disable: orders are still saved and the customer's own WhatsApp button on
# the confirmation page keeps working. Never sent to customers, only to the shop.
CALLMEBOT_API_KEY=

# ─────────────── Web (Next.js) ───────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Production is https://rgiservice.ma — inlined at BUILD time, so changing it needs a redeploy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_GA_ID=G-XXXXXXX
NEXT_PUBLIC_DEFAULT_LOCALE=fr
