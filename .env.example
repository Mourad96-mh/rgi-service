# ─────────────── API (NestJS) ───────────────
PORT=4000
NODE_ENV=development
# MongoDB must be a replica set to support transactions (Atlas is by default;
# for local dev run a single-node replica set).
MONGODB_URI=mongodb://127.0.0.1:27017/rgiservice?replicaSet=rs0
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
CORS_ORIGINS=http://localhost:3000

# ─────────────── Cloudinary ───────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_key
CLOUDINARY_API_SECRET=your_secret
CLOUDINARY_UPLOAD_PRESET=rgi_service_products
# Namespace for this project's media inside a Cloudinary account shared with other projects.
CLOUDINARY_FOLDER=rgi-service/products

# ─────────────── CMI payment (Morocco) ───────────────
CMI_MERCHANT_ID=your_merchant_id
CMI_STORE_KEY=your_store_key
CMI_GATEWAY_URL=https://payment.cmi.co.ma/fim/est3Dgate
CMI_CALLBACK_URL=https://yourdomain.ma/api/v1/payments/cmi/callback
CMI_OK_URL=https://yourdomain.ma/commande/succes
CMI_FAIL_URL=https://yourdomain.ma/commande/echec

# ─────────────── Web (Next.js) ───────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_GA_ID=G-XXXXXXX
NEXT_PUBLIC_DEFAULT_LOCALE=fr
